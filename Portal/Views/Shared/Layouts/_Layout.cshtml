<!DOCTYPE html>
<html>
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YM5EQN4L8Y"></script>

    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-YM5EQN4L8Y');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="../../Content/Images/Logos/APW-Logo-07.png" type="image/x-icon" />

    <title>@ViewBag.Title</title>
    @RenderSection("header", required: false)


    <link href="~/Content/style.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />

    <!--LOCAL RESOURCES
    <link href="~/Content/CSS/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/Content/CSS/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/CSS/all.min.css" rel="stylesheet" />
    <link href="~/Content/CSS/jquery-ui.css" rel="stylesheet" />
        -->

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @Scripts.Render("~/bundles/modernizr")


    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Sofia">

</head>
<body>
    @{
        Html.RenderPartial("_HeaderMenu");
    }


    @RenderBody()


    <footer style="position: fixed; bottom: 0; left: 0; right: 0; width: 100%; z-index: 1000; background-color: #f8f9fa; border-top: 1px solid #e9ecef; padding: 6px 0; font-family: 'Roboto', sans-serif; text-align: center; font-size: 11px; color: #6c757d;">
        <div style="max-width: 1200px; margin: 0 auto; padding: 0 15px;">
            <p style="margin: 0; line-height: 1.4;">
                <a href="@Url.Action("MeetTheTeam", "Account")" class="footer-link" style="color: #6c757d; text-decoration: none;">
                    <strong>About Us:</strong> Learn more about the developers and technical support team behind this platform &rarr;
                </a>
                <span style="margin: 0 6px;">|</span>
                <span>
                    Powered By: <a href="https://asiapeopleworks.com.ph/" target="_blank" class="footer-link" style="color: #6c757d; text-decoration: none;">Asia Peopleworks</a>
                </span>
                <span style="margin: 0 6px;">|</span>
                <a href="https://asiapeopleworks.com.ph/privacy-policy/" target="_blank" class="footer-link" style="color: #6c757d; text-decoration: none;">Privacy Policy</a>
                <span style="margin: 0 6px;">|</span>
                <a href="https://asiapeopleworks.com.ph/terms__condition/" target="_blank" class="footer-link" style="color: #6c757d; text-decoration: none;">Terms & Conditions</a>
            </p>
        </div>
    </footer>

    <style>
        .footer-link {
            transition: color 0.2s ease;
        }

            .footer-link:hover {
                color: #2563eb !important;
                text-decoration: underline !important;
            }
    </style>

    @{
        Html.RenderPartial("~/Views/Shared/_Toasters.cshtml");
    }

    <div class="preloader-container" id="preloader">
        @*<div class="preloader"></div>*@
        <img src="~/Content/Loader/Loader.gif" style="width:300px; height: 180px;" alt="">
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/ui/1.13.1/jquery-ui.js"></script>

    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="https://www.google.com/jsapi"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
    <script src="https://cdn.canvasjs.com/canvasjs.min.js"></script>

    <script src="~/Scripts/Global/core.min.js"></script>
    <script src="~/Scripts/Global/Global.js"></script>


    @RenderSection("scripts", required: false)

    @Html.Partial("~/Views/Attendance/Modal/ClockInOut/_clockin_modal.cshtml")
</body>
</html>
