@model APWModel.ViewModel.Portal.Attendance_model.Correction_model
@using (Html.BeginForm("_AddCorrection", "Attendance", FormMethod.Post, new { enctype = "multipart/form-data", name = "post-attendance-correction-Form", id = "post-attendance-correction-Form" }))
{
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.UserId)
    @Html.HiddenFor(m => m.EmpId)
    @Html.HiddenFor(m => m.Remarks)
    @Html.HiddenFor(m => m.HasAttachement)
    @Html.HiddenFor(m => m.FileExtension)

    <div class="instruction-box shadow-sm mb-4 border-0 rounded-3 overflow-hidden">
        <div class="d-flex align-items-center justify-content-between p-3 bg-info-subtle border-start border-5 border-info"
             data-bs-toggle="collapse"
             href="#postCorrectionInstructionsCollapse"
             role="button"
             aria-expanded="false"
             aria-controls="postCorrectionInstructionsCollapse"
             style="cursor: pointer;">
            <div class="d-flex align-items-center">
                <div class="pulse-container me-3">
                    <i class="fa-solid fa-circle-info fs-4 text-info"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">Attendance Correction Rules</h6>
                    <small class="text-muted d-block d-md-none">Tap to view requirements</small>
                </div>
            </div>
            <div class="text-end">
                <span class="badge rounded-pill bg-info text-white mb-1 d-none d-md-inline-block">Policy</span>
                <i class="fa-solid fa-chevron-down text-dark ms-2 transition-icon"></i>
            </div>
        </div>

        <div class="collapse" id="postCorrectionInstructionsCollapse">
            <div class="p-3 bg-white">
                <ul class="list-unstyled mb-0 small">

                    @if (string.IsNullOrEmpty(Model.DynamicRuleMessage) ||
                         Model.DynamicRuleMessage == "No Client Detected" ||
                         Model.DynamicRuleMessage == "Follow default rule.")
                    {
                        <li class="mb-2 d-flex">
                            <i class="fa-solid fa-clock text-danger me-2 mt-1"></i>
                            <span><strong>Filing Deadline:</strong> Attendance correction must be filed within 48 hours (2 days) after the actual attendance date.</span>
                        </li>
                    }
                    
                    @if (!string.IsNullOrEmpty(Model.DynamicRuleMessage) &&
                          Model.DynamicRuleMessage != "No Client Detected" &&
                          Model.DynamicRuleMessage != "Follow default rule.")
                    {
                        <li class="mb-2 d-flex">
                            <i class="fa-solid fa-triangle-exclamation text-warning me-2 mt-1"></i>
                            <span><strong>Filing Rule:</strong> @Model.DynamicRuleMessage</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="row" id="div-validation" style="display: none;">
        <div class="col mb-3">
            <label for="html" id="error-message-label" class="form-label text-danger"></label><br>
        </div>
    </div>
    <div class="row">
        <div class="col-6 mb-3">
            <label for="" class="form-label">Date Log</label>
            @Html.TextBoxFor(m => m.DateLog, new { @class = "form-control", @placeholder = "mm/dd/yyyy", @type = "date", @Value = Model.DateLog.ToString("yyyy-MM-dd"), @id = "DateLog" })
        </div>
        <div class="col-6 mb-3">
            <label for="" class="form-label">Work Location</label>
            @Html.DropDownListFor(m => m.WorkLocation,
                new List<SelectListItem> {
                    new SelectListItem { Text = "Office", Value = "1" },
                    new SelectListItem { Text = "Home", Value = "2" },
                    new SelectListItem { Text = "Onsite Work", Value = "3" }
                },
                "Please Select",
                new { @class = "form-select" })
        </div>
    </div>
    <div class="row">
        <div class="col mb-3">
            <label for="" class="form-label">Shift</label>
            @Html.DropDownListFor(m => m.ShiftId, (IEnumerable<SelectListItem>)ViewBag._ClientShift, "Please Select", new { @class = "form-select", @placeholder = "Shift" })
        </div>
    </div>
    <div class="row">
        <label for="" class="form-label">Time In</label>
        <div class="col">
            @Html.TextBoxFor(m => m.TimeInDate, new { @class = "form-control", @placeholder = "mm/dd/yyyy", @type = "date", @Value = Model.TimeInDate.ToString("yyyy-MM-dd"), @id = "TimeInDate" })
        </div>
        <div class="col">
            @Html.TextBoxFor(m => m.TimeInTime, new { @class = "form-control", @placeholder = "Time Out", @type = "time", @Value = Model.TimeInTime.ToString("HH:mm"), @id = "TimeInTime" })
        </div>
    </div>
    <div class="row mt-2">
        <label for="" class="form-label">Time Out</label>
        <div class="col">
            @Html.TextBoxFor(m => m.TimeOutDate, new { @class = "form-control", @placeholder = "mm/dd/yyyy", @type = "date", @Value = Model.TimeOutDate.ToString("yyyy-MM-dd"), @id = "TimeOutDate" })
        </div>
        <div class="col">
            @Html.TextBoxFor(m => m.TimeOutTime, new { @class = "form-control", @placeholder = "Time Out", @type = "time", @Value = Model.TimeOutTime.ToString("HH:mm"), @id = "TimeOutTime" })
        </div>
    </div>
    <div class="row mt-2 ">
        <div class="col">
            <label class="form-label-custom">Reason for Attendance correction</label>
            @Html.TextAreaFor(m => m.Reason, 3, 40, new { @class = "form-control", @placeholder = "Briefly explain the reason for applying an Attendance correction..." })
        </div>
    </div>
    <div class="row mt-2">
        <div class="col">
            <label class="form-label-custom">Update Attachment (Optional)</label>
            <input class="form-control" type="file" name="Correction_Attachment" id="Correction_Attachment">
        </div>
    </div>
}

<script type="text/javascript">
(function () {
    function initPostCorrectionLogic() {
        var timeInDateInput = document.getElementById("TimeInDate");
        var timeOutDateInput = document.getElementById("TimeOutDate");
        var dateLogInput = document.getElementById("DateLog");

        var ruleMessage = "@(Model.DynamicRuleMessage ?? "")";
        var daysAllowed = 2; // Default

        if (ruleMessage.toLowerCase().includes("day")) {
            var match = ruleMessage.match(/(\d+)/);
            if (match) daysAllowed = parseInt(match[0]);
        }

        var minDate = new Date();
        minDate.setDate(minDate.getDate() - daysAllowed);
        var minDateString = minDate.toISOString().split('T')[0];

        if (timeInDateInput) timeInDateInput.setAttribute("min", minDateString);
        if (timeOutDateInput) timeOutDateInput.setAttribute("min", minDateString);
        if (dateLogInput) dateLogInput.setAttribute("min", minDateString);

        var dateInputs = document.querySelectorAll('#post-attendance-correction-Form input[type="date"]');
        dateInputs.forEach(function (input) {
            input.addEventListener('keydown', function (e) {
                e.preventDefault();
            });
            input.addEventListener('paste', function (e) {
                e.preventDefault();
            });
        });

        if (timeInDateInput) {
            var syncDates = function () {
                var selectedValue = timeInDateInput.value;
                if (timeOutDateInput) timeOutDateInput.value = selectedValue;
                if (dateLogInput) dateLogInput.value = selectedValue;
            };

            timeInDateInput.addEventListener("input", syncDates);
            timeInDateInput.addEventListener("change", syncDates);
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initPostCorrectionLogic);
    } else {
        initPostCorrectionLogic();
    }
})();
</script>