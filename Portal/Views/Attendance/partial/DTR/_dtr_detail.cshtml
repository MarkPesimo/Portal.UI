@model APWModel.ViewModel.Portal.DTR_model.DTRmodel

<style>
    #dtrContainer {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        background-color: #fff;
        border-radius: 5px;
        padding: 10px;
    }

    input[type="month"].month-only::-webkit-datetime-edit-year-field {
        display: none;
    }
    input[type="month"].month-only::-moz-datetime-edit-year-field {
        display: none;
    }

    #dtrContainer table {
        width: 100%;
        min-width: 1000px;
    }

    #dtrContainer .card table {
        min-width: 500px;
    }

    #dtrContainer th, #dtrContainer td {
        white-space: nowrap;
        padding: 5px 8px !important;
    }

    .dtr-filter-bar {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 12px;
    }

    .dtr-filter-bar .form-label {
        font-size: 0.8rem;
        margin-bottom: 2px;
    }

    .dtr-date-divider {
        margin-bottom: 8px;
    }

    .dtr-guidelines {
        background: #fff8e6;
        border: 1px solid #ffe69c;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 12px;
    }

    .dtr-guidelines h6 {
        color: #664d03;
    }

    .dtr-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 250px;
        text-align: center;
        color: #6c757d;
        padding: 20px 16px;
    }

    .dtr-empty-state img {
        max-width: 220px;
        width: 60%;
        margin-bottom: 16px;
        opacity: 0.9;
    }

    .dtr-empty-state p {
        font-size: 0.95rem;
        margin: 0;
    }

    @@media (max-width: 767px) {
        .dtr-empty-state {
            min-height: 180px;
        }
        .dtr-empty-state img {
            max-width: 140px;
        }
        .dtr-empty-state p {
            font-size: 0.85rem;
            padding: 0 8px;
        }
    }

    .dtr-partial-footer {
        flex-shrink: 0; 
    }
</style>

<div class="d-flex flex-column h-100">

    <div class="dtr-guidelines">
        <div class="d-flex justify-content-between align-items-center guidelines-toggle" data-bs-toggle="collapse" data-bs-target="#collapseGuidelines" aria-expanded="false" aria-controls="collapseGuidelines">
            <h6 class="fw-bold mb-0">Important Review Guidelines</h6>
            <i class="fa-solid fa-chevron-down"></i>
        </div>

        <div class="collapse" id="collapseGuidelines">
            <ul class="mb-0 small ps-3 mt-2">
                <li>
                    <strong>Approval Status:</strong> Ensure you have marked all Attendance Corrections, OT, and Leaves as
                    <span class="badge rounded-pill bg-success">Approved</span>. Items you have marked as <span class="badge rounded-pill bg-warning text-dark">Posted</span> are still pending review and <strong>will not be counted</strong> in your submission.
                </li>
                <li class="mt-1">
                    <strong>Late/Undertime Alert:</strong> Double-check your entries with <span class="text-danger fw-bold">Red Font</span> in the Time In/Out columns. These indicate late or undertime records that you may need to correct to avoid salary deductions.
                </li>
                <li class="mt-1">
                    <strong>Found a Discrepancy?</strong> If you notice an incorrect entry or need to add or correct information, <strong>do not proceed</strong> with creating your DTR. Please coordinate with your account supervisor first before filing.
                </li>
            </ul>
        </div>
    </div>
    <div class="dtr-filter-bar">
        @using (Html.BeginForm("_AddCorrection", "Attendance", FormMethod.Post, new { enctype = "multipart/form-data", name = "dtr-Form", id = "dtr-Form" }))
        {
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.EmpId)
            @Html.HiddenFor(m => m.UserId)
            @Html.HiddenFor(m => m.Mode)
            @Html.HiddenFor(m => m.DateCreated)
            @Html.HiddenFor(m => m.Remarks)

            <div class="row" id="div-validation" style="display: none;">
                <div class="col-12 mb-2">
                    <label id="error-message-label" class="form-label text-danger mb-0"></label>
                </div>
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-4 col-md-2">
                    <label class="form-label">Cutoff</label>
                    @Html.DropDownListFor(m => m.CutOff,
                        new SelectList(new[] {
                            new { Value = "1ST CUTOFF", Text = "1ST CUT OFF" },
                            new { Value = "2ND CUTOFF", Text = "2ND CUT OFF" }
                        }, "Value", "Text", Model.CutOff),
                        new { @class = "form-select form-select-sm", id = "Cutoff" })
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label">Month</label>
                    @Html.TextBoxFor(m => m.Month, new { @class = "form-control form-control-sm month-only", type = "month", id = "Month" })
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label">Year</label>
                    @Html.DropDownListFor(m => m.Year,
                        new SelectList(Enumerable.Range(DateTime.Now.Year - 5, 11).Select(y => new { Value = y.ToString(), Text = y.ToString() }), "Value", "Text", Model.Year ?? DateTime.Now.Year.ToString()),
                        new { @class = "form-select form-select-sm", id = "Year" })
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Date From</label>
                    @Html.TextBox("DateFrom", Model.DateFrom != DateTime.MinValue ? Model.DateFrom.ToString("yyyy-MM-dd") : "", new { @class = "form-control form-control-sm fw-bold", type = "date", id = "DateFrom" })
                </div>
                <div class="col-auto d-none d-md-flex align-items-center px-0 dtr-date-divider">
                    <i class="fa-solid fa-arrow-right-long text-muted"></i>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Date To</label>
                    @Html.TextBox("Dateto", Model.Dateto != DateTime.MinValue ? Model.Dateto.ToString("yyyy-MM-dd") : "", new { @class = "form-control form-control-sm fw-bold", type = "date", id = "DateTo" })
                </div>
            </div>
        }
    </div>

    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between mb-2">
        <label class="form-label fw-bold text-primary mb-2 mb-lg-0 fs-5 text-nowrap">DTR Preview</label>
        <div class="dtr-legend fs-6 d-flex flex-wrap align-items-center gap-2">
            @*<small class="fw-normal font-italic w-100 d-block d-md-inline w-md-auto">(Hover table icons for details)</small>*@
            <span><i class="fa-solid fa-circle-half-stroke text-danger"></i> Half Day Absent</span>
            <span><i class="fa-solid fa-circle-xmark text-danger"></i> Absent</span>
            <span><i class="fa-solid fa-umbrella-beach text-danger"></i> Leave</span>
            <span><i class="fa-solid fa-calendar-check text-warning"></i> Rest Day</span>
        </div>
    </div>
    <div id="dtrContainer">
        <div class="dtr-empty-state" id="dtrEmptyState">
            <img src="@Url.Content("~/Content/animation/selectdtr.gif")" alt="Select DTR" />
            <p>Select a <strong>Cutoff</strong>, <strong>Month</strong>, and <strong>Date range</strong> above, then choose an employee to preview their DTR.</p>
        </div>
    </div>

</div>
