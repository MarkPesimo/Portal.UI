<style>
    #preview_dtr_modal .modal-content {
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 12px 32px rgba(0,0,0,0.15);
    }

    #preview_dtr_modal .modal-header {
        background: #1a1a1a;
        color: #fff;
        border-bottom: none;
        padding: 16px 20px;
    }

        #preview_dtr_modal .modal-header .modal-title {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
        }

        #preview_dtr_modal .modal-header .btn-close {
            filter: invert(1) grayscale(100%) brightness(200%);
            opacity: 0.85;
        }

            #preview_dtr_modal .modal-header .btn-close:hover {
                opacity: 1;
            }

    #preview_dtr_modal .modal-body {
        padding: 0;
        min-height: 200px;
    }

    #preview_dtr_modal .modal-body-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
        color: #6c757d;
    }

        #preview_dtr_modal .modal-body-loading img {
            width: 90px;
            height: 90px;
            margin-bottom: 10px;
        }

    #preview_dtr_modal .modal-footer {
        background: #f8f9fa;
        border-top: 1px solid #eee;
        padding: 12px 20px;
    }

    #preview_dtr_modal #close_print_DTR {
        display: flex;
        align-items: center;
        gap: 6px;
        border-radius: 6px;
    }
</style>

<div class="modal fade" id="preview_dtr_modal" tabindex="-1" aria-labelledby="jobOrderLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header Zips-modal-header">
                <h1 class="modal-title fs-5" id="jobOrderLabel">
                    <i class="fa-regular fa-file-pdf"></i> Print DTR
                </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="preview_dtr_modal_body">
                <div class="modal-body-loading">
                    <img src="@Url.Content("~/Content/animations/process.gif")" alt="Loading" />
                    <small>Preparing document...</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="close_print_DTR" data-bs-dismiss="modal">
                    <i class="fa-regular fa-circle-check"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>